<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>九州 9 天行程｜熊本進・福岡出（2026/12/27–2027/1/4）</title>
  <style>
    :root {
      --bg: #f6f7f9;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --primary: #1d4ed8;
      --primary-soft: #eff6ff;
      --accent: #0f766e;
      --accent-soft: #f0fdfa;
      --warn: #b45309;
      --warn-soft: #fffbeb;
      --border: #e5e7eb;
      --radius: 14px;
      --shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", "PingFang TC", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    header {
      background: linear-gradient(135deg, #1e3a8a 0%, #0f766e 100%);
      color: #fff;
      padding: 28px 18px 24px;
    }

    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 0 16px;
    }

    header .container {
      padding: 0 4px;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(1.45rem, 4vw, 2.1rem);
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .subtitle {
      margin: 0 0 16px;
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.96rem;
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .badge {
      background: rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      padding: 5px 11px;
      border-radius: 999px;
      font-size: 0.82rem;
    }

    .notice-banner {
      margin: 18px auto 10px;
      background: var(--warn-soft);
      border: 1px solid #fde68a;
      color: #78350f;
      border-radius: var(--radius);
      padding: 14px 16px;
      font-size: 0.92rem;
    }

    .notice-banner strong {
      color: var(--warn);
    }

    .day-nav-wrap {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(246, 247, 249, 0.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      padding: 10px 0;
    }

    .day-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    .day-tabs::-webkit-scrollbar {
      display: none;
    }

    .day-tab {
      flex: 0 0 auto;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .day-tab:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .day-tab.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }

    main {
      padding: 18px 0 40px;
    }

    .day-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
      margin-bottom: 18px;
    }

    .day-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 12px;
      margin-bottom: 16px;
    }

    .day-title {
      margin: 0;
      font-size: 1.25rem;
      color: #111827;
    }

    .day-date {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--primary);
      background: var(--primary-soft);
      padding: 4px 10px;
      border-radius: 8px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }

    @media (min-width: 768px) {
      .grid-2 {
        grid-template-columns: 1.15fr 0.85fr;
      }
    }

    .section-box {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
      background: #fafafa;
    }

    .section-box h3 {
      margin: 0 0 8px;
      font-size: 0.98rem;
      color: #111827;
    }

    .section-box ul {
      margin: 0;
      padding-left: 18px;
    }

    .section-box li {
      margin-bottom: 6px;
      font-size: 0.93rem;
    }

    .transport-box {
      background: var(--accent-soft);
      border-color: #99f6e4;
    }

    .transport-box h3 {
      color: var(--accent);
    }

    .note-box {
      margin-top: 12px;
      background: var(--warn-soft);
      border: 1px solid #fde68a;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 0.88rem;
      color: #78350f;
    }

    .summary-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
      margin-top: 24px;
    }

    .summary-card h2 {
      margin: 0 0 12px;
      font-size: 1.18rem;
    }

    .ticket-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    @media (min-width: 640px) {
      .ticket-list {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .ticket-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      background: #fcfcfd;
    }

    .ticket-item strong {
      display: block;
      margin-bottom: 4px;
      color: #111827;
    }

    .ticket-item span {
      font-size: 0.88rem;
      color: var(--muted);
    }

    footer {
      text-align: center;
      color: var(--muted);
      font-size: 0.84rem;
      padding: 12px 16px 32px;
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1>九州 9 天行程｜熊本進・福岡出</h1>
      <p class="subtitle">2026/12/27 – 2027/1/4｜星宇早去晚回（JX846 去／JX841 回）｜跨年末年始與 RWD 行程表</p>
      <div class="badges">
        <span class="badge">去程 12/27 07:30 TPE → 10:35 KMJ</span>
        <span class="badge">回程 1/4 19:10 FUK → 20:50 TPE</span>
        <span class="badge">不硬排阿蘇山區・節奏穩健</span>
      </div>
    </div>
  </header>

  <div class="day-nav-wrap">
    <div class="container">
      <div class="day-tabs" id="dayTabs" role="tablist" aria-label="行程天數切換"></div>
    </div>
  </div>

  <div class="container">
    <div class="notice-banner">
      <strong>年末年始提醒：</strong>熊本城往年 <strong>12/29</strong> 例行休園，已排在 <strong>12/28（Day 2）</strong>；<strong>12/31</strong> 多數店家提早打烊、<strong>1/1</strong> 許多商場／餐廳休息、<strong>1/2</strong> 起迎來新年初賣。若 Day 3 當天看天氣極佳想顺路看草千里，可作為彈性備案。
    </div>
  </div>

  <main class="container">
    <div id="itineraryContainer"></div>

    <section class="summary-card">
      <h2>票券與交通重點整理</h2>
      <div class="ticket-list">
        <div class="ticket-item">
          <strong>1. 西鐵「太宰府・柳川觀光套票」（2 日券）</strong>
          <span>建議於 Day 7（1/2）啟用，連用 Day 7 太宰府與 Day 8 柳川遊船，比單買划算。</span>
        </div>
        <div class="ticket-item">
          <strong>2. 福岡市地下鐵＆熊本市電</strong>
          <span>福岡地鐵刷同一張信用卡享單日最高 640 日圓封頂；熊本市電單程約 200 日圓，單日搭 3 趟可買手機版 500 日圓一日券。</span>
        </div>
        <div class="ticket-item">
          <strong>3. 跨縣巴士與特急列車預約</strong>
          <span>1/1 湯布院→博多「由布號」高速巴士或 JR 特急（如由布院之森）建議提早線上預約座位，避開年末年始客滿。</span>
        </div>
        <div class="ticket-item">
          <strong>4. 返程機場接駁（Day 9）</strong>
          <span>福岡市地下鐵機場線至福岡機場站約 5 分鐘，出站轉搭免費接駁巴士至國際線航廈，建議約 16:00–16:30 出發。</span>
        </div>
      </div>
    </section>
  </main>

  <footer>
    實際班次、票價、門票與年末年始營業時間請以各官方公告為準。
  </footer>

  <script>
    const days = [
      {
        day: "Day 1",
        date: "12/27（日）",
        title: "抵達熊本・水前寺庭園與上下通散策",
        schedule: [
          "10:35 抵達熊本機場，入境領行李後前往市區寄放行李",
          "午餐：黑亭拉麵 或 赤牛丼",
          "下午：水前寺成趣園（門票約 400 日圓）、熊本熊部長辦公室（留意開放與見面時段）",
          "傍晚～晚餐：上通・下通商店街逛街，晚餐推薦勝烈亭 新市街本店 或 紅蘭亭"
        ],
        transport: [
          "熊本機場 → 市區：搭乘熊本機場利木津巴士（約 50–60 分鐘）",
          "市區移動：熊本市電（單程均一約 200 日圓，當日搭 3 趟可考慮手機版 500 日圓一日券）"
        ],
        note: "第一天以適應氣候與市區逛街為主，順便確認隔天前往熊本城的路線。"
      },
      {
        day: "Day 2",
        date: "12/28（一）",
        title: "熊本城歷史巡禮・櫻町與熊本站商圈",
        schedule: [
          "上午：熊本城（成人門票約 800 日圓）＋ 加藤神社",
          "中午：櫻之馬場 城彩苑散步吃小食，正餐可選菅乃屋或熊本鄉土料理",
          "下午：SAKURA MACHI 櫻町熊本（約停留 1～1.5 小時買伴手禮與看頂樓景觀）",
          "晚上：JR 熊本站商圈逛街，晚餐推薦天外天拉麵 或 天國馬肉料理"
        ],
        transport: [
          "熊本城：搭熊本市電至「熊本城・市役所前」站步行",
          "熊本站：搭熊本市電 A 系統往返"
        ],
        note: "避開往年 12/29 熊本城例行休園日，把重點古蹟排在今天最穩妥。"
      },
      {
        day: "Day 3",
        date: "12/29（二）",
        title: "從容移動至別府溫泉鄉・地獄巡禮",
        schedule: [
          "上午：熊本市區悠閒喝咖啡或補逛後，啟程前往別府溫泉鄉",
          "下午：別府地獄溫泉巡禮（海地獄、灶地獄等，共通券約 2,200 日圓／單館約 450 日圓）",
          "晚餐：東洋軒（雞肉天婦羅）或 とよ常 本店"
        ],
        transport: [
          "熊本 → 別府：搭乘跨縣高速巴士（需提前預約）或 JR 轉乘前往別府",
          "別府市內：搭乘龜之井巴士往返別府站與鐵輪地獄溫泉區"
        ],
        note: "不硬排阿蘇山區與折返路線，直接往別府推進更順；若當天看天氣極佳想看草千里，可作彈性調整。"
      },
      {
        day: "Day 4",
        date: "12/30（三）",
        title: "鐵輪蒸氣美食・鶴見岳纜車與溫泉放鬆",
        schedule: [
          "上午：鐵輪溫泉區散步，午餐體驗地獄蒸工房 鐵輪 或 龜正迴轉壽司",
          "下午：別府空中纜車（鶴見岳纜車，來回票約 1,800 日圓）或海濱砂湯",
          "晚上：胡月冷麵 或 溫泉飯店泡湯休息"
        ],
        transport: [
          "別府市區 ↔ 鐵輪／別府纜車：搭乘龜之井巴士"
        ],
        note: "冬季山上風大氣溫低，搭纜車或戶外散步請備妥保暖外套與防滑鞋。"
      },
      {
        day: "Day 5",
        date: "12/31（四）",
        title: "湯布院金鱗湖・湯之坪街道跨年夜",
        schedule: [
          "上午：自別府前往湯布院，逛金鱗湖與周邊小徑",
          "中午：由布まぶし 心（釜飯）",
          "下午：湯之坪街道逛街、買甜點（12/31 店家較早打烊，建議早點買）",
          "跨年夜：建議預訂溫泉旅館一泊二食，泡湯迎接新年"
        ],
        transport: [
          "別府 ↔ 湯布院：龜之井巴士 36 號線（約 55 分鐘）或 JR 久大本線特急（需預約）"
        ],
        note: "12/31 許多餐廳與商店提早結束營業，跨年夜晚餐與住宿務必提前確認。"
      },
      {
        day: "Day 6",
        date: "1/1（五）",
        title: "元旦移動至福岡博多・櫛田神社初詣",
        schedule: [
          "上午：自湯布院或別府移動至福岡博多，飯店寄放行李",
          "下午：櫛田神社元旦初詣參拜 → 川端通商店街 → 博多運河城",
          "晚餐：牛腸鍋 樂天地 或 一蘭 運河城店"
        ],
        transport: [
          "湯布院 → 博多：高速巴士「由布號」（約 2 小時，需預約）或 JR 特急（需提前搶票）",
          "市區移動：福岡市地下鐵或步行"
        ],
        note: "1/1 適逢日本元旦，不少百貨與小店休息，運河城與部分神社周邊較易營業。"
      },
      {
        day: "Day 7",
        date: "1/2（六）",
        title: "太宰府初詣・天神新年初賣與中洲屋台",
        schedule: [
          "上午：太宰府天滿宮參拜、吃現烤梅枝餅",
          "中午：暖暮拉麵 或 葫蘆壽司",
          "下午：天神商圈逛新年初賣／福袋（天神地下街、百貨商場）",
          "晚上：中洲屋台街 或 博多名代 吉塚鰻魚屋"
        ],
        transport: [
          "建議啟用西鐵「太宰府・柳川觀光套票」（2 日券），搭西鐵電車往返太宰府"
        ],
        note: "1/2 初詣與商場初賣人潮眾多，熱門餐廳與電車建議錯開最尖峰時段。"
      },
      {
        day: "Day 8",
        date: "1/3（日）",
        title: "柳川暖桌遊船・大濠公園與福岡塔夜景",
        schedule: [
          "上午：柳川護城河遊船（冬季暖桌船），午餐吃元祖本吉屋 或 若松屋 蒸籠鰻魚飯",
          "下午：大濠公園、福岡城跡／舞鶴公園散步",
          "傍晚～晚上：福岡塔看夜景（門票約 1,000 日圓），晚餐 Shin-Shin 拉麵 或 極味屋"
        ],
        transport: [
          "續用西鐵「太宰府・柳川觀光套票」搭西鐵特急往返柳川＋搭船",
          "市區移動：福岡市地下鐵（同一張信用卡單日最高 640 日圓封頂）＋公車"
        ],
        note: "柳川遊船與鰻魚飯安排在上午至中午最順，下午回到福岡市區看夜景與吃晚餐。"
      },
      {
        day: "Day 9",
        date: "1/4（一）",
        title: "博多最後補貨・星宇晚班機返台",
        schedule: [
          "上午：明太子法國麵包早餐（DACOMECCA 或 THE FULLFULL HAKATA）",
          "中午～下午：博多車站／AMU PLAZA 最後伴手禮採買與午餐（利久牛舌或海鮮食堂）",
          "16:00–16:30 左右前往福岡機場辦理登機與退稅，搭乘星宇 JX841（19:10 起飛）返台"
        ],
        transport: [
          "博多站 → 福岡機場站：搭福岡市地下鐵機場線（約 5 分鐘），轉搭免費接駁巴士至國際線航廈"
        ],
        note: "晚班機白天時間充裕，但國際線航廈需轉搭接駁巴士且旺季排隊較長，建議提早前往機場。"
      }
    ];

    const tabsEl = document.getElementById("dayTabs");
    const containerEl = document.getElementById("itineraryContainer");
    let activeFilter = "ALL";

    function renderTabs() {
      const allBtn = document.createElement("button");
      allBtn.className = "day-tab active";
      allBtn.textContent = "全部 9 天";
      allBtn.dataset.day = "ALL";
      tabsEl.appendChild(allBtn);

      days.forEach((d) => {
        const btn = document.createElement("button");
        btn.className = "day-tab";
        btn.textContent = `${d.day} ${d.date}`;
        btn.dataset.day = d.day;
        tabsEl.appendChild(btn);
      });

      tabsEl.addEventListener("click", (e) => {
        const target = e.target.closest(".day-tab");
        if (!target) return;
        activeFilter = target.dataset.day;
        document.querySelectorAll(".day-tab").forEach((b) => {
          b.classList.toggle("active", b.dataset.day === activeFilter);
        });
        renderCards();
        if (activeFilter !== "ALL") {
          containerEl.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    }

    function renderCards() {
      const list = activeFilter === "ALL" ? days : days.filter((d) => d.day === activeFilter);
      containerEl.innerHTML = list
        .map(
          (d) => `
          <article class="day-card">
            <div class="day-header">
              <h2 class="day-title">${d.day}：${d.title}</h2>
              <span class="day-date">${d.date}</span>
            </div>
            <div class="grid-2">
              <div class="section-box">
                <h3>行程與推薦餐廳</h3>
                <ul>
                  ${d.schedule.map((item) => `<li>${item}</li>`).join("")}
                </ul>
              </div>
              <div class="section-box transport-box">
                <h3>詳細交通工具與票券</h3>
                <ul>
                  ${d.transport.map((item) => `<li>${item}</li>`).join("")}
                </ul>
              </div>
            </div>
            <div class="note-box">
              <strong>提醒：</strong>${d.note}
            </div>
          </article>
        `
        )
        .join("");
    }

    renderTabs();
    renderCards();
  </script>
</body>
</html>
